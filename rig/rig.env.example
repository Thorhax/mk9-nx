# Copy to rig/rig.env (Git ignores it) and fill it in. Plain KEY=value lines: the shell scripts source this file and
# the Python ones parse it, so no shell expansions; single-quote a value with shell characters in it.

# The Switch. sys-botbase has no authentication: LAN only, never port-forward it.
SWITCH_IP=192.168.1.x
SB_PORT=6000
# The FTP server on the Switch (ftpsrv or similar) and its login
FTP_PORT=5000
FTP_USER=
FTP_PASS=

# This PC, for configs that send the log over the network (configs/KNNL: log_network = "@PC_IP@:28773")
PC_IP=192.168.1.y
# nxlink from devkitPro's switch-tools
NXLINK=/opt/devkitpro/tools/bin/nxlink

# Where runs are kept (default: mk9-logs/rig beside the mk9-nx checkout). Run loglisten.py 28773 <MK9_LOGS>/net.
#MK9_LOGS=
# Scratch files for refresh_cache.sh and step.sh (default: <MK9_LOGS>/tmp)
#RIG_TMP=
